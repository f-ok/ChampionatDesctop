<Page x:Class="подготовка.summary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:подготовка"
      mc:Ignorable="d" d:DesignWidth="190"
      Title="summary" Height="auto">

    <Grid>
        <Canvas>
            <Label 
                 x:Name="btn"
                Width="190" 
                Height="30"
                Content="Состояние сети" Background="LightGray"
                MouseDown="Btn_OnMouseDown"
                MouseMove="Btn_OnMouseMove"
                MouseUp="Btn_OnMouseUp" HorizontalAlignment="Left" VerticalAlignment="Center" >

            </Label>
            <Grid Height="auto" Width="190" HorizontalAlignment="Center" Canvas.Top="30" VerticalAlignment="Top" Background="White" x:Name="grid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="Выручка, сегодня"/>
                    <Label Content="Выручка, вчера"/>
                    <Label Content="Обслужено ТА, сег./вчера"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Label Content="N/A" x:Name="RevTod"/>
                    <Label Content="N/A" x:Name="RevYes"/>
                    <Label x:Name="Service"/>
                </StackPanel>
            </Grid>
        </Canvas>
    </Grid>
</Page>
