<Page x:Class="подготовка.networkStatus"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:подготовка"
      mc:Ignorable="d" 
      d:DesignHeight="180" d:DesignWidth="150"
      Title="networkStatus">

    <Grid>
        <Canvas>
            <Label 
                x:Name="btn"
                Width="150"
                Height="30"
                Content="Состояние сети" Background="LightGray"
                MouseDown="Btn_OnMouseDown"
                MouseMove="Btn_OnMouseMove"
                MouseUp="Btn_OnMouseUp" HorizontalAlignment="Left" VerticalAlignment="Center" >

            </Label>
            <Canvas x:Name="RingCanvas"
            Width="150" Height="150"
                Canvas.Top="30"
                >
            

            <!-- Внутренняя белая окружность (дырка) -->
            <Ellipse Width="80" Height="80"
             Fill="White"
             Canvas.Left="35" Canvas.Top="35"/>
            <!-- Здесь код‑behind будет дорисовывать цветные секторы Path -->
            </Canvas>
        </Canvas>
          
       
    </Grid>
</Page>
