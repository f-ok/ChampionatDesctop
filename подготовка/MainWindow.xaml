            <StackPanel x:Name="panell" Grid.Row="1" Visibility="Visible" Panel.ZIndex="3">
                <Button Content="asd" Panel.ZIndex="3" />
                <Button Content="asdasd"  Panel.ZIndex="3"/>
                <Button Content="asdxzv"  Panel.ZIndex="3"/>
            </StackPanel>

        </Grid>
         -->


        <Grid Grid.Row="2" Background="#1a1f26" Grid.Column="0" HorizontalAlignment="Left"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

                <RowDefinition x:Name="xey" Height="0"/>

                <RowDefinition Height="Auto"/>


                <RowDefinition Height="Auto"/>



            </Grid.RowDefinitions>

            <Button Content="Главная" x:Name="Menu" Width="auto" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}" Click="Main_Click" ></Button>
            <Button x:Name="a"  Grid.Column="0" Grid.Row="1" Background="#1a1f26" Foreground="White" Width="auto" Content="Монитор ТА" BorderBrush="{x:Null}"  />
            <Button Grid.Row="2" Content="Детальные отчеты" x:Name="Detail" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  />


            <Button Grid.Row="3" Content="Учет ТМЦ" Click="TMC_Click" x:Name="TMC" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  />

            <StackPanel Visibility="Hidden" x:Name="dsa" Grid.Row="4">
                <Button Content="asd" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  ></Button>
            </StackPanel>

            <Button Grid.Row="5" Content="Администратирование" x:Name="Administration" Click="Administration_Click" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  />

            <StackPanel x:Name="asd" Grid.Row="6" Visibility="Hidden" HorizontalAlignment="Right" Background="#1a1f26" >
                <Button Content="Торговые автоматы" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}" Click="TA_Click" ></Button>
                <Button Content="Компании" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  ></Button>
                <Button Content="Пользователи" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  />
                <Button Content="Модемы" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  />
                <Button Content="Дополнительные" Background="#1a1f26" Foreground="White" BorderBrush="{x:Null}"  />
            </StackPanel>



        </Grid>


        <Frame Grid.Row="2" Grid.Column="2" Name="MainFrame"  ></Frame>
        <Frame Grid.Row="2" Grid.Column="2" Name="AdminFrame" Visibility="Hidden"/>

        <Frame Grid.Column="1" Name="DropDownPage" Panel.ZIndex="0" Margin="0,0,0,80" Grid.RowSpan="3" />
    </Grid>

</Window>
