<Page x:Class="подготовка.AdminTA"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:подготовка"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminTA">

    <Grid Background="white">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid>

                <StackPanel>
                    <Label Content="Торговые атоматы"/>
                    <Label Content="Всего найдено" x:Name="CountOfTA"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Label Content="Показать"/>
                <ComboBox x:Name="Numbers" Width="50" VerticalContentAlignment="Center" DataContextChanged="Numbers_DataContextChanged" />
                <Label Content="записей"/>

            </StackPanel>
            <TextBox Text="Фильтр" HorizontalAlignment="Center" Grid.Row="1" Width="200"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить" Click="Button_Click1"/>
                <Button Content="Экспорт"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Height="350" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Hidden" >

            </ScrollViewer>
            <DataGrid x:Name="DGVendingMachines" IsReadOnly="True" AutoGenerateColumns="False" Grid.Row="2" 
              RowBackground="LightGray" AlternatingRowBackground="White"
              >
                <DataGrid.Columns >
                    <DataGridTextColumn Header="ID" Binding="{Binding serial_number}" Width="20" />
                    <DataGridTextColumn x:Name="name" Header="Название автомата" Binding="{Binding name}"/>
                    <DataGridTextColumn Header="Модель" Binding="{Binding model}" />
                    <DataGridTextColumn Header="Компания" Binding="{Binding company}"/>
                    <DataGridTextColumn Header="Адрес/место" Binding="{Binding location}"/>
                    <DataGridTextColumn Header="В работе с" Binding="{Binding install_date}"/>
                    <DataGridTextColumn Header="Действия" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>


    </Grid>
</Page>
