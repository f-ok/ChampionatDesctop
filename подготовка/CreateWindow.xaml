<Window x:Class="подготовка.CreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:подготовка"
        mc:Ignorable="d"
        Title="CreateWindow" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Создание торгового автомата"
               FontSize="18" FontWeight="Bold"
               Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Левая колонка -->

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название ТА*" Margin="0,0,0,2"/>
            <TextBox x:Name="tbName" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Режим работы*" Margin="0,5,0,2"/>
            <ComboBox x:Name="cbWorkMode" Grid.Row="3" Grid.Column="0" Margin="0,0,10,5">
                <ComboBoxItem Content="Стандартный"/>
                <ComboBoxItem Content="Круглосуточный"/>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес" Margin="0,5,0,2"/>
            <TextBox x:Name="tbAddress" Grid.Row="5" Grid.Column="0" Margin="0,0,10,5"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Номер автомата (серийный)" Margin="0,5,0,2"/>
            <TextBox x:Name="tbSerial" Grid.Row="7" Grid.Column="0" Margin="0,0,10,5"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Дата ввода в эксплуатацию" Margin="0,5,0,2"/>
            <DatePicker x:Name="dpInstallDate" Grid.Row="9" Grid.Column="0" Margin="0,0,10,5"/>

            <!-- Средняя колонка -->

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Производитель ТА*" Margin="10,0,0,2"/>
            <ComboBox x:Name="cbCompany" Grid.Row="1" Grid.Column="1" Margin="10,0,10,5"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="Модель ТА*" Margin="10,5,0,2"/>
            <TextBox x:Name="tbModel" Grid.Row="3" Grid.Column="1" Margin="10,0,10,5"/>

            <TextBlock Grid.Row="4" Grid.Column="1" Text="Место" Margin="10,5,0,2"/>
            <TextBox x:Name="tbPlace" Grid.Row="5" Grid.Column="1" Margin="10,0,10,5"/>

            <TextBlock Grid.Row="6" Grid.Column="1" Text="Время работы (формат: 08:00-22:00)" Margin="10,5,0,2"/>
            <TextBox x:Name="tbWorkingHours" Grid.Row="7" Grid.Column="1" Margin="10,0,10,5"/>

            <TextBlock Grid.Row="8" Grid.Column="1" Text="Статус" Margin="10,5,0,2"/>
            <ComboBox x:Name="cbStatus" Grid.Row="9" Grid.Column="1" Margin="10,0,10,5">
                <ComboBoxItem Content="Работает"/>
                <ComboBoxItem Content="Вышел из строя"/>
                <ComboBoxItem Content="В ремонте/на обслуживании"/>
            </ComboBox>

            <!-- Правая колонка -->

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Платежная система*" Margin="10,0,0,2"/>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,5">
                <CheckBox x:Name="cbCash" Content="Наличные" Margin="0,0,10,0"/>
                <CheckBox x:Name="cbCard" Content="Карта" Margin="0,0,10,0"/>
                <CheckBox x:Name="cbQr" Content="QR-платежи"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Часовой пояс" Margin="10,5,0,2"/>
            <ComboBox x:Name="cbTimezone" Grid.Row="3" Grid.Column="2" Margin="10,0,0,5">
                <ComboBoxItem Content="UTC +3"/>
                <ComboBoxItem Content="UTC +4"/>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="2" Text="Менеджер" Margin="10,5,0,2"/>
            <TextBox x:Name="tbManager" Grid.Row="5" Grid.Column="2" Margin="10,0,0,5"/>

            <TextBlock Grid.Row="6" Grid.Column="2" Text="Примечания" Margin="10,5,0,2"/>
            <TextBox x:Name="tbNotes" Grid.Row="7" Grid.Column="2" Margin="10,0,0,5"
                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Создать" Width="100" Margin="0,0,10,0"
                Click="CreateButton_Click"/>
            <Button Content="Отменить" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>

</Window>
