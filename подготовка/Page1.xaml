<Page x:Class="подготовка.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:подготовка"
      mc:Ignorable="d" 
      d:DesignHeight="165" d:DesignWidth="300"
      Title="Page1">

    <Grid>

        <Canvas Panel.ZIndex="1" Background="White">
            <Label 
                x:Name="btn"
                Width="300"
                Height="40"
                Content="Эффективность сети" Background="LightGray"
                MouseDown="Btn_OnMouseDown"
                MouseMove="Btn_OnMouseMove"
                MouseUp="Btn_OnMouseUp" HorizontalAlignment="Left" VerticalAlignment="Center" >





            </Label>
            <!-- Зеленая дуга -->
            <Path x:Name="btn1" StrokeThickness="20" Stroke="LimeGreen" HorizontalAlignment="Left" VerticalAlignment="Bottom" Canvas.Left="50" Canvas.Top="60">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="10,90">
                            <ArcSegment Point="190,90"
                                Size="80,80"
                                SweepDirection="Clockwise"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- Стрелка -->
            <Rectangle x:Name="Needle" Width="4" Height="80"
                Fill="Black" RadiusX="2" RadiusY="2"
                RenderTransformOrigin="0.5,1" Canvas.Left="150" Canvas.Top="60" >
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="NeedleRotate" Angle="-90"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Border Background="White"/>
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Canvas.Top="147" VerticalAlignment="Center" Width="300" x:Name="Text" Canvas.Left="0"  />
        </Canvas>


    </Grid>
</Page>
